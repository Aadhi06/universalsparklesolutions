NEXT_PUBLIC_SITE_URL=https://universalsparklesolution.com.au
NEXT_PUBLIC_ANALYTICS_ID=

# Server-only. Never expose these in frontend code.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
LARAVEL_API_URL=
LARAVEL_API_TOKEN=

# Web Push for the admin app. Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@universalsparklesolution.com.au

# Outbound email for enquiry chat replies.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Universal Sparkle Solution <admin@universalsparklesolution.com.au>
